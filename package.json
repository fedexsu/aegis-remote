{
  "name": "aegis-remote",
  "version": "0.1.0",
  "description": "Aegis Remote — an unattended remote-support tool (relay server, Electron agent with full control, web console).",
  "main": "agent/main.js",
  "scripts": {
    "server": "node server/relay.js",
    "agent": "electron .",
    "build-injector": "node agent/injector/build-injector.js",
    "build-agent": "node build-agent.js",
    "build-bundle": "node scripts/build-agent-bundle.js",
    "build:all": "node build-all.js",
    "sign": "powershell -ExecutionPolicy Bypass -File signing/sign.ps1 release/Aegis/Aegis.exe release/AegisSetup.exe",
    "get-signing-tools": "python signing/download-tools.py"
  },
  "author": "Cheyenne Smith",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "rcedit": "^5.0.2"
  }
}
